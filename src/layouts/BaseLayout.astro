---
import '../styles/global.css'
import Seo from '../components/Seo.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
interface Props { title: string; description?: string; locale?: 'it' | 'en' }
const { title, description, locale = 'it' } = Astro.props
---
<!doctype html><html lang={locale}><head><Seo title={title} description={description} /></head><body><Header locale={locale} /><main><slot /></main><Footer /></body></html>
