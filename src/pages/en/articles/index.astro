---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
const articles = (await getCollection('articles')).filter(({ data }) => !data.draft && data.locale === 'en').sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
---
<BaseLayout locale="en" title="Articles"><section class="prose"><p class="eyebrow">Journal</p><h1>Articles</h1><ul class="article-list">{articles.map(({ id, data }) => <li><a href={`/en/articles/${id.replace(/^en\//, '')}/`}><strong>{data.title}</strong><span>{data.description}</span></a></li>)}</ul></section></BaseLayout>
